---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Greydemar Serrano | Marketing & Project Manager</title>
  <meta name="title" content="Greydemar Serrano | Marketing & Project Manager">
  <meta name="description" content="Especialista en Growth Marketing, Creación de Contenido y Project Management.">

  <!-- FAVICON: "G" en perspectiva con FONDO ROJO -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23dc2626%22 rx=%2212%22/><g transform=%22skewX(-15)%22><text x=%2260%22 y=%2272%22 font-size=%2265%22 font-weight=%22900%22 font-family=%22sans-serif%22 fill=%22%23ffffff%22 text-anchor=%22middle%22>G</text></g></svg>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="animate-on-load">

  <!-- SISTEMA DE ZOOM GLOBAL -->
