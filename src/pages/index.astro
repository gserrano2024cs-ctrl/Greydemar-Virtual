    <svg class="sticker sticker-star" width="45" height="45" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <polyline points="3 3 3 21 21 21" stroke="#FEF08A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <polyline points="3 17 9 11 13 15 21 7" stroke="#FEF08A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <polyline points="14 7 21 7 21 14" stroke="#FEF08A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <svg class="sticker sticker-plant" width="65" height="65" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="3" width="20" height="14" rx="2" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8 21h8" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 17v4" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <polyline points="8 8 5 11 8 14" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <polyline points="16 8 19 11 16 14" stroke="#bbf7d0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <svg class="sticker sticker-sparkle" width="45" height="45" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" stroke="#fbcfe8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="12" cy="13" r="3" stroke="#fbcfe8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <!-- 1. SECCIÓN HERO -->
  <section class="hero-wrapper fade-in-section delay-1">
    <div class="hero-video-container">
      <video autoplay loop muted playsinline class="video-bg"><source src="/avila.webm" type="video/webm" /></video>
      <div class="avila-overlay"></div>
    </div>

    <header class="top-header">
      <div class="brand-centered">GREY SERRANO®</div>
      <div class="lang-switch dark-mode">
        <button class="lang-btn active" onclick="setLanguage('es')">ES</button>
        <button class="lang-btn" onclick="setLanguage('en')">EN</button>
      </div>
    </header>

    <main class="hero-container">
      <div class="left-col">
        <div class="glass-profile-card" onclick="this.classList.toggle('active')">
          <div class="card-min-header">
            <img src="/grey.jpeg" alt="Greydemar Serrano" class="profile-thumb shift-right" id="heroProfileImg" onclick="toggleProfileZoom(event)" title="Ver a detalle" />
            <div class="min-meta">
              <div class="status-line"><span class="green-dot"></span><span class="status-text" data-es="En línea" data-en="Online">En línea</span></div>
              <div class="name-group">
                <h2 class="min-name">GREYDEMAR SERRANO</h2>
                <span class="min-title" data-es="Especialista en Marketing Digital y Conversión Web" data-en="Digital Marketing & Web Conversion Specialist">Especialista en Marketing Digital y Conversión Web</span>
              </div>
            </div>
          </div>
          <div class="card-expand-content">
            <p class="expand-bio" data-es="Soy Greydemar Serrano 👋🏽<br><br>Construyo ecosistemas rentables con contenido de alto impacto y con sistemas de cierre comercial y plataformas ultrarrápidas.<br><br><strong>Mi objetivo:</strong> eliminar fricción, posicionar tu autoridad y multiplicar tu conversión." data-en="I am Greydemar Serrano 👋🏽<br><br>I build profitable ecosystems with high-impact content, commercial closing systems, and ultra-fast platforms.<br><br><strong>My goal:</strong> eliminate friction, position your authority, and multiply your conversion.">
              Soy Greydemar Serrano 👋🏽<br><br>Construyo ecosistemas rentables con contenido de alto impacto y con sistemas de cierre comercial y plataformas ultrarrápidas.<br><br><strong>Mi objetivo:</strong> eliminar fricción, posicionar tu autoridad y multiplicar tu conversión.
            </p>
            <p class="skills-title" data-es="Mis habilidades:" data-en="My skills:">Mis habilidades:</p>
            <div class="skills-grid">
              <span>Astro</span><span>GitHub</span><span>HTML5</span><span>CSS3</span>
              <span>GA4</span><span>Salesforce</span><span>Zoho CRM</span><span>Mailchimp</span>
              <span class="wide-skill" data-es="Creación de Contenido" data-en="Content Creation">Creación de Contenido</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-center-text">
        <h1 data-es="ESTRATEGIA QUE UNE MARKETING, VENTAS Y WEB" data-en="STRATEGY BRIDGING MARKETING, SALES & WEB">ESTRATEGIA QUE UNE MARKETING, VENTAS Y WEB</h1>
        <span class="floating-pill pill-pink">Growth Marketing</span>
        <span class="floating-pill pill-green">Project Manager</span>
        <span class="floating-pill pill-yellow" data-es="Contenido Visual" data-en="Visual Content">Contenido Visual</span>
      </div>

      <div class="glass-cases-card" onclick="this.classList.toggle('active')">
        <div class="cases-min-header">
          <span class="cases-title-text" data-es="Casos Destacados" data-en="Featured Cases">Casos Destacados</span>
          <span class="search-icon-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
        </div>
        <div class="cases-expand-content">
          <ul class="quick-cases-list">
            <li><a href="#projects" onclick="setTimeout(() => openModal('modal-yprealty'), 400);"><strong>YP Realty</strong><span data-es="Growth +604%" data-en="Growth +604%">Growth +604%</span></a></li>
            <li><a href="#projects" onclick="setTimeout(() => openModal('modal-panhouse'), 400);"><strong>Editorial PanHouse</strong><span data-es="Comunicaciones Internas" data-en="Internal Comms">Comunicaciones Internas</span></a></li>
            <li><a href="#projects" onclick="setTimeout(() => openModal('modal-eurobuilding'), 400);"><strong>Eurobuilding</strong><span data-es="Comunicaciones & Ventas" data-en="Comms & Sales">Comunicaciones & Ventas</span></a></li>
            <li><a href="#projects" onclick="setTimeout(() => openModal('modal-dislocal'), 400);"><strong>Dislocal</strong><span data-es="Project Coordinator" data-en="Project Coordinator">Project Coordinator</span></a></li>
            <li><a href="#projects" onclick="setTimeout(() => openModal('modal-impaktemos'), 400);"><strong>Impaktemos</strong><span data-es="Coordinación Operativa" data-en="Operational Coordination">Coordinación Operativa</span></a></li>
            <li><a href="#projects" onclick="setTimeout(() => openModal('modal-freelance'), 400);"><strong>Freelance</strong><span data-es="Diseño & Web" data-en="Design & Web">Diseño & Web</span></a></li>
          </ul>
        </div>
      </div>

      <div class="hero-quote-corner">
        <span data-es="- Facturar no es casualidad. Depende de cómo te ven, cómo conectas y qué tan fácil les haces comprar." data-en="- Invoicing is no accident. It depends on how they see you, how you connect, and how easy you make it to buy.">
          - Facturar no es casualidad. Depende de cómo te ven, cómo conectas y qué tan fácil les haces comprar.
        </span>
      </div>
    </main>
  </section>

  <!-- 1.5 LOGO MARQUEE INFINITO -->
  <section class="marquee-section fade-in-section delay-2">
    <div class="marquee-container">
      <div class="marquee-track">
        <img src="/logo plano creativo.png" alt="Plano Creativo"><img src="/logo dislocal.png" alt="Dislocal"><img src="/logo plano mariano moreno.png" alt="Instituto Superior Mariano Moreno"><img src="/logo impaktemos.png" alt="Impaktemos"><img src="/logo universidad.png" alt="Universidad"><img src="/logo yprealty.png" alt="YP Realty"><img src="/logo eurobuilding.png" alt="Eurobuilding Hotels"><img src="/logo panhouse.png" alt="PanHouse">
        <img src="/logo plano creativo.png" alt="Plano Creativo"><img src="/logo dislocal.png" alt="Dislocal"><img src="/logo plano mariano moreno.png" alt="Instituto Superior Mariano Moreno"><img src="/logo impaktemos.png" alt="Impaktemos"><img src="/logo universidad.png" alt="Universidad"><img src="/logo yprealty.png" alt="YP Realty"><img src="/logo eurobuilding.png" alt="Eurobuilding Hotels"><img src="/logo panhouse.png" alt="PanHouse">
        <img src="/logo plano creativo.png" alt="Plano Creativo"><img src="/logo dislocal.png" alt="Dislocal"><img src="/logo plano mariano moreno.png" alt="Instituto Superior Mariano Moreno"><img src="/logo impaktemos.png" alt="Impaktemos"><img src="/logo universidad.png" alt="Universidad"><img src="/logo yprealty.png" alt="YP Realty"><img src="/logo eurobuilding.png" alt="Eurobuilding Hotels"><img src="/logo panhouse.png" alt="PanHouse">
      </div>
    </div>
  </section>

  <!-- 2. ABOUT ME -->
  <section id="about" class="about-section fade-in-section delay-3">
    <div class="about-container">
      <div class="sticky-note">
        <svg class="real-pin" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 10V22" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="7" r="5" fill="#ef4444" stroke="#b91c1c" stroke-width="1.5"/><circle cx="10.5" cy="5.5" r="1.5" fill="#ffffff" opacity="0.6"/></svg>
        <span class="note-text" data-es="About Me" data-en="About Me">About Me</span>
      </div>
      <div class="about-header">
        <h2 data-es="Hago un trabajo que las personas nunca olvidan." data-en="I do work that people never forget.">Hago un trabajo que las personas nunca olvidan.</h2>
        <p class="about-subtitle" data-es="Entiendo cómo funciona la mente del consumidor. Las ventas mantienen tu negocio, pero la gente compra por <strong>cómo te ve</strong>. Me enfoco en la psicología detrás de cada detalle para conectar de forma genuina, retener la atención y generar los resultados exactos que buscas como equipo." data-en="I understand how the consumer's mind works. Sales sustain your business, but people buy based on <strong>how they see you</strong>. I focus on the psychology behind every detail to connect genuinely, retain attention, and generate the exact results you seek as a team.">Entiendo cómo funciona la mente del consumidor. Las ventas mantienen tu negocio, pero la gente compra por <strong>cómo te ve</strong>. Me enfoco en la psicología detrás de cada detalle para conectar de forma genuina, retener la atención y generar los resultados exactos que buscas como equipo.</p>
      </div>

      <div class="mac-window">
        <div class="mac-titlebar">
          <div class="mac-buttons"><span class="mac-dot red"></span><span class="mac-dot yellow"></span><span class="mac-dot green"></span></div>
        </div>
        <div class="mac-content">
          <div class="bio-image-col"><img src="/memoji.png" alt="Memoji Greydemar" class="memoji-circle animated-memoji" /></div>
          <div class="bio-info-col">
            <p class="bio-intro" data-es="Soy <strong>Greydemar Serrano</strong>, comunicadora social, con más de 5 años de experiencia con una visión estratégica orientada a los resultados." data-en="I am <strong>Greydemar Serrano</strong>, a social communicator, with over 5 years of experience with a strategic, results-oriented vision.">Soy <strong>Greydemar Serrano</strong>, comunicadora social, con más de 5 años de experiencia con una visión estratégica orientada a los resultados.</p>
            <div class="stats-grid-about">
              <div class="stat-item"><h3 class="iridescent-text">+5</h3><p data-es="Años de experiencia" data-en="Years of experience">Años de experiencia</p></div>
              <div class="stat-item"><h3 class="iridescent-text">+8</h3><p data-es="Proyectos coordinados" data-en="Projects coordinated">Proyectos coordinados</p></div>
              <div class="stat-item"><h3 class="iridescent-text">+5</h3><p data-es="Eventos de alto impacto" data-en="High-impact events">Eventos de alto impacto</p></div>
              <div class="stat-item"><h3 class="iridescent-text">+13</h3><p data-es="Marcas y organizaciones" data-en="Brands and organizations">Marcas y organizaciones</p></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PROYECTOS -->
  <section id="projects" class="projects-section fade-in-section delay-4">
    <div class="projects-container">
      <div class="sticky-note">
        <svg class="real-pin pin-blue" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 10V22" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="7" r="5" fill="#3b82f6" stroke="#1d4ed8" stroke-width="1.5"/><circle cx="10.5" cy="5.5" r="1.5" fill="#ffffff" opacity="0.6"/></svg>
        <span class="note-text" data-es="Casos" data-en="Cases">Casos</span>
      </div>
      <div class="section-header">
        <h2 data-es="Proyectos que cuentan historias." data-en="Projects that tell stories.">Proyectos que cuentan historias.</h2>
        <p data-es="Selección de ecosistemas y estrategias destacadas." data-en="Selection of featured ecosystems and strategies.">Selección de ecosistemas y estrategias destacadas.</p>
