            <p class="card-company" data-es="Diseño & Web" data-en="Design & Web">Diseño & Web</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SERVICIOS -->
  <section id="services" class="services-section fade-in-section delay-5">
    <div class="services-container">
      <div class="sticky-note">
        <svg class="real-pin" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 10V22" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="7" r="5" fill="#f59e0b" stroke="#b45309" stroke-width="1.5"/><circle cx="10.5" cy="5.5" r="1.5" fill="#ffffff" opacity="0.6"/></svg>
        <span class="note-text" data-es="Servicios" data-en="Services">Servicios</span>
      </div>
      <div class="section-header">
        <h2 data-es="Cómo te ayudo a crecer." data-en="How I help you grow.">Cómo te ayudo a crecer.</h2>
        <p data-es="Haz clic en cada servicio para ver cómo soluciono tus necesidades." data-en="Click on each service to see how I solve your needs.">Haz clic en cada servicio para ver cómo soluciono tus necesidades.</p>
      </div>

      <div class="services-grid-blocks">
        <div class="service-block service-toggle" style="background: rgba(59, 130, 246, 0.08); border-color: rgba(59, 130, 246, 0.2);" onclick="this.classList.toggle('open')">
